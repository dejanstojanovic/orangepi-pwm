{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ServiceConfiguration": {
    "BusId": 5,
    "DeviceAddressHex": "0x3c",
    "Interval": 3,
    "Rotate": true,
    "TimeOn": 60
  },
  "SoundConfiguration": {
    "ActivationSound": "/etc/orangepi-status-display/notify.mp3"
  },
  "BuzzerConfig": {
    "GPIO": 138,
    "PWMFrequency": 100000,
    "PWMDuty": 0.5
  },
  "SwitchConfig": {
    "ProximitySensorSwitchConfig": {
      "GPIO": 92
    },
    "ProximitySensorSwitchConfig": {
      "GPIO": 92
    }
  }

}
